# ====================================================================
# Evidence-First Deep Research Engine Configuration Template
# Copy this file to .env and configure your local settings.
# ====================================================================

# Groq API Key (Get a free API key at: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Inference Models
# Primary synthesis, planning and extraction model (supports reasoning)
GROQ_MODEL=openai/gpt-oss-120b
# Fast verification model
GROQ_VERIFIER_MODEL=openai/gpt-oss-20b

# Research Limits & Scope
TARGET_SOURCES=100
MAX_RESEARCH_ROUNDS=3
PER_DOMAIN_URL_LIMIT=6
INTER_REQUEST_DELAY_SECONDS=1.5

# Search Provider Switches (All free public providers)
ENABLE_DDGS=True
ENABLE_HACKERNEWS=True
ENABLE_OPENALEX=True
ENABLE_ARXIV=True

# Network & Extraction
FETCH_TIMEOUT_SECONDS=15.0
MAX_RESPONSE_BYTES=5242880
FETCH_CONCURRENCY=3
ENABLE_JINA_FALLBACK=True
JINA_TIMEOUT_SECONDS=15.0

# Security Boundaries
BLOCK_PRIVATE_IPS=True

# Database & Dashboard
DATABASE_PATH=data/research_vault.db
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501

